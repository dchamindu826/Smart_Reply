# ───────── Smart Reply production settings (copy to infra/.env) ─────────

# Your domain, pointed at this server's IP (A record). Caddy gets HTTPS for it.
DOMAIN=app.example.com
# Email for Let's Encrypt certificate notices.
ACME_EMAIL=you@example.com

# Database password (long and random).
POSTGRES_PASSWORD=change-me
# 64 hex characters each. Generate:  openssl rand -hex 32
JWT_SECRET=change-me
# Encrypts every company's Meta token. Never change it after go-live; keep a copy in a password manager.
ENCRYPTION_KEY=change-me

# First LUMI AI admin login, created on first start. Remove the password after the first start.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-10-plus-characters
SEED_ADMIN_NAME=LUMI AI Admin

# Files: "local" keeps them in the Docker volume "storage". For S3/R2/Spaces set "s3" and fill below.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=smart-reply
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# Email for staff invites and password resets (any SMTP: Gmail Workspace, Zoho, SendGrid, SES…).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Smart Reply <no-reply@example.com>

META_GRAPH_VERSION=v26.0
# Optional, from expo.dev, for mobile push notifications.
EXPO_ACCESS_TOKEN=
# Flutter app push: Firebase service account key as ONE line of JSON (wrap in single quotes).
FCM_SERVICE_ACCOUNT_JSON=
LOG_LEVEL=info

# AI voice agent (answers WhatsApp calls). The Gemini key can also be set in the admin console
# (AI → Platform), which wins over this one.
GEMINI_API_KEY=
# The server's public IPv4. Meta sends call audio here on UDP 40000-40099 (open them in the firewall).
VOICE_PUBLIC_IP=
VOICE_MAX_CALLS=20
